# Copy to .env and fill in values. NEVER commit a real .env file.
# Everything below is OPTIONAL: the app runs without any of these variables
# (image classifiers work offline; the features below degrade gracefully).

# --- Database (Record Input / Retrieve Crop Data pages) ---
# sqlite = built-in demonstration database (default; zero setup)
# mysql  = real MySQL server; requires the variables below and scripts/schema_mysql.sql
DB_MODE=sqlite

# Required only when DB_MODE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=plant_app_user
DB_PASSWORD=change-me
DB_NAME=farm_demo

# --- Optional external services ---
# OpenAI key enables the Question Answering page
OPENAI_API_KEY=

# SerpAPI key enables the Google Search page
SERPAPI_API_KEY=

# --- Upload limits ---
MAX_UPLOAD_MB=10
